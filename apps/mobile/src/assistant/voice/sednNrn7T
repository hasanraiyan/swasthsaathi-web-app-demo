import {
  usePersonaContext,
  type PersonaVoiceEndReason,
  type PersonaVoiceState,
  type PersonaVoiceToolCall,
  type PersonaVoiceTranscriptLine,
  type UseVoiceOptions,
  type UseVoiceResult,
} from '@personaai/react';
import { useCallback, useEffect, useMemo, useRef, useState } from 'react';
import {
  AudioBufferQueueSourceNode,
  AudioContext,
  AudioManager,
  AudioRecorder,
} from 'react-native-audio-api';

/**
 * Native (Android/iOS) port of `@personaai/react`'s `useVoice`.
 *
 * The SDK hook needs browser-only APIs (`getUserMedia`, `AudioWorklet`), so on native
 * the mic and speaker go through `react-native-audio-api` instead. The wire protocol
 * is identical to the SDK's (see sdk/react/src/hooks/useVoice.ts), and it returns the
 * same `UseVoiceResult` shape, so it plugs straight into `useChat({ voice })`:
 *
 *   1. POST /voice/sessions on our API → a short-lived ticket
 *   2. WebSocket straight to Persona (`ticket.wsUrl`), not through our API
 *   3. Upstream: raw 16-bit mono PCM in 20ms frames at `inputSampleRate`
 *   4. Downstream: binary frames = 4-byte LE turnSeq + 16-bit PCM at `outputSampleRate`,
 *      plus JSON AG-UI events (CUSTOM voice_* / TOOL_CALL_* / RUN_ERROR)
 */

interface VoiceSessionTicket {
  wsUrl: string;
}

interface VoiceTranscriptValue {
  speaker: 'user' | 'agent';
  text: string;
  isFinal: boolean;
  turnSeq?: number;
}

const FRAME_MS = 20;

// Same merge the SDK does: Gemini Live sends one agent utterance as several final
// fragments, each either a cumulative snapshot or only the new words.
function mergeTranscriptText(prev: string, next: string): string {
  if (!prev) return next;
  if (!next) return prev;
  if (next === prev || prev.endsWith(next)) return prev;
  if (next.startsWith(prev)) return next;
  const needSpace = !/\s$/.test(prev) && !/^\s/.test(next);
  return prev + (needSpace ? ' ' : '') + next;
}

/** Linear resample — the recorder may deliver a different rate than requested. */
function resample(input: Float32Array, from: number, to: number): Float32Array {
  if (from === to) return input;
  const ratio = from / to;
  const out = new Float32Array(Math.floor(input.length / ratio));
  for (let i = 0; i < out.length; i++) {
    const pos = i * ratio;
    const idx = Math.floor(pos);
    const frac = pos - idx;
    const a = input[idx] ?? 0;
    const b = input[idx + 1] ?? a;
    out[i] = a + (b - a) * frac;
  }
  return out;
}

function floatToInt16(samples: Float32Array): Int16Array {
  const out = new Int16Array(samples.length);
  for (let i = 0; i < samples.length; i++) {
    const s = Math.max(-1, Math.min(1, samples[i]!));
    out[i] = s < 0 ? s * 0x8000 : s * 0x7fff;
  }
  return out;
}

function int16BytesToFloat(bytes: ArrayBuffer): Float32Array<ArrayBuffer> {
  const pcm = new Int16Array(bytes, 0, Math.floor(bytes.byteLength / 2));
  const out = new Float32Array(pcm.length);
  for (let i = 0; i < pcm.length; i++) out[i] = pcm[i]! / 0x8000;
  return out;
}

export function useAssistantVoice(options: UseVoiceOptions = {}): UseVoiceResult {
  const { defaultAgentId, fetchWithAuth, logger: rootLogger } = usePersonaContext();
  const logger = useMemo(() => rootLogger.child('voice:native'), [rootLogger]);
  const agentId = options.agentId || defaultAgentId;
  const { threadId, contextOverride, context } = options;

  const [state, setState] = useState<PersonaVoiceState>('idle');
  const [isMuted, setIsMuted] = useState(false);
  const [transcript, setTranscript] = useState<PersonaVoiceTranscriptLine[]>([]);
  const [partial, setPartial] = useState<PersonaVoiceTranscriptLine | null>(null);
  const [toolCalls, setToolCalls] = useState<PersonaVoiceToolCall[]>([]);
  const [error, setError] = useState<Error | null>(null);
  const [endReason, setEndReason] = useState<PersonaVoiceEndReason | null>(null);

  const wsRef = useRef<WebSocket | null>(null);
  const recorderRef = useRef<AudioRecorder | null>(null);
  const playCtxRef = useRef<AudioContext | null>(null);
  const queueRef = useRef<AudioBufferQueueSourceNode | null>(null);
  const outputRateRef = useRef(24000);
  const pendingMicRef = useRef<Int16Array>(new Int16Array(0));
  const mutedRef = useRef(false);
  const acceptedTurnSeqRef = useRef(0);
  const lastFinalTurnRef = useRef<{ speaker: string; turnSeq?: number } | null>(null);
  const mountedRef = useRef(true);
  // Frame counters, logged every ~5s at debug so a silent mic / silent speaker is easy to spot.
  const statsRef = useRef({ micFrames: 0, micBytes: 0, rxFrames: 0, rxBytes: 0, dropped: 0, last: 0 });

  useEffect(() => {
    mountedRef.current = true;
    return () => {
      mountedRef.current = false;
    };
  }, []);

  const fail = useCallback((err: unknown) => {
    const e = err instanceof Error ? err : new Error(String(err));
    logger.warn('voice error', { error: e.message });
    if (mountedRef.current) {
      setError(e);
      setState('error');
    }
  }, [logger]);

  const teardownAudio = useCallback(() => {
    logger.debug('teardown audio', { ...statsRef.current });
    const recorder = recorderRef.current;
    recorderRef.current = null;
    if (recorder) {
      try {
        recorder.clearOnAudioReady();
        void recorder.stop();
      } catch {
        // already stopped
      }
    }
    try {
      queueRef.current?.stop();
    } catch {
      // never started
    }
    queueRef.current = null;
    const ctx = playCtxRef.current;
    playCtxRef.current = null;
    if (ctx) void ctx.close().catch(() => {});
    pendingMicRef.current = new Int16Array(0);
    void AudioManager.setAudioSessionActivity(false).catch(() => {});
  }, [logger]);

  const closeSocket = useCallback((reason?: string) => {
    const ws = wsRef.current;
    wsRef.current = null;
    if (ws) {
      try {
        ws.close(1000, reason);
      } catch {
        // already closed
      }
    }
  }, []);

  const stop = useCallback(() => {
    logger.debug('stop() called');
    closeSocket('client_stop');
    teardownAudio();
    if (mountedRef.current) setState('idle');
  }, [closeSocket, logger, teardownAudio]);

  useEffect(() => stop, [stop]);

  /** A fresh queue node — also how barge-in drops audio the agent was mid-way through. */
  const resetPlayer = useCallback(() => {
    const ctx = playCtxRef.current;
    if (!ctx) return;
    try {
      queueRef.current?.clearBuffers();
      queueRef.current?.stop();
    } catch {
      // not started yet
    }
    const queue = ctx.createBufferQueueSource();
    queue.connect(ctx.destination);
    queue.start();
    queueRef.current = queue;
  }, []);

  const startAudio = useCallback(
    async (inputSampleRate: number, outputSampleRate: number) => {
      // voiceChat mode turns on the platform echo canceller so the agent doesn't hear itself.
      AudioManager.setAudioSessionOptions({
        iosCategory: 'playAndRecord',
        iosMode: 'voiceChat',
        iosOptions: ['defaultToSpeaker', 'allowBluetoothHFP'],
      });
      await AudioManager.setAudioSessionActivity(true);
      logger.debug('audio session active', { inputSampleRate, outputSampleRate });

      outputRateRef.current = outputSampleRate;
      playCtxRef.current = new AudioContext({ sampleRate: outputSampleRate });
      resetPlayer();

      const frameSamples = Math.round((inputSampleRate * FRAME_MS) / 1000);
      const recorder = new AudioRecorder();
      recorderRef.current = recorder;
      const ready = recorder.onAudioReady(
        { sampleRate: inputSampleRate, bufferLength: frameSamples * 2, channelCount: 1 },
        ({ buffer }) => {
          const ws = wsRef.current;
          if (!ws || ws.readyState !== WebSocket.OPEN || mutedRef.current) return;
          if (statsRef.current.micFrames === 0) {
            logger.debug('first mic buffer', { deliveredRate: buffer.sampleRate, requestedRate: inputSampleRate, samples: buffer.length });
          }
          const mono = resample(buffer.getChannelData(0), buffer.sampleRate, inputSampleRate);
          const pcm = floatToInt16(mono);
          // Re-frame into exact 20ms chunks, same as the SDK's recorder worklet.
          const joined = new Int16Array(pendingMicRef.current.length + pcm.length);
          joined.set(pendingMicRef.current);
          joined.set(pcm, pendingMicRef.current.length);
          let offset = 0;
          while (joined.length - offset >= frameSamples) {
            ws.send(joined.slice(offset, offset + frameSamples).buffer);
            statsRef.current.micFrames += 1;
            statsRef.current.micBytes += frameSamples * 2;
            offset += frameSamples;
          }
          pendingMicRef.current = joined.slice(offset);
          const now = Date.now();
          if (now - statsRef.current.last > 5000) {
            statsRef.current.last = now;
            logger.debug('audio stats', { ...statsRef.current, muted: mutedRef.current });
          }
        },
      );
      if (ready.status === 'error') throw new Error(ready.message);
      const started = await recorder.start();
      if (started.status === 'error') throw new Error(started.message);
      logger.debug('recorder started', { frameSamples, bufferLength: frameSamples * 2 });
    },
    [logger, resetPlayer],
  );

  const playPcm = useCallback((bytes: ArrayBuffer) => {
    const ctx = playCtxRef.current;
    const queue = queueRef.current;
    if (!ctx || !queue || bytes.byteLength < 2) return;
    const samples = int16BytesToFloat(bytes);
    const buffer = ctx.createBuffer(1, samples.length, outputRateRef.current);
    buffer.copyToChannel(samples, 0);
    queue.enqueueBuffer(buffer);
  }, []);

  const upsertToolCall = useCallback((id: string, patch: Partial<PersonaVoiceToolCall>) => {
    setToolCalls((prev) => {
      const idx = prev.findIndex((t) => t.id === id);
      if (idx === -1) return [...prev, { id, status: 'running', ...patch }];
      const next = [...prev];
      next[idx] = { ...next[idx], ...patch } as PersonaVoiceToolCall;
      return next;
    });
  }, []);

  const handleTranscript = useCallback(({ speaker, text, isFinal, turnSeq }: VoiceTranscriptValue) => {
    if (!isFinal) {
      setPartial({ id: 'partial', speaker, text });
      return;
    }
    setPartial((prev) => (prev?.speaker === speaker ? null : prev));

    const last = lastFinalTurnRef.current;
    const sameUserBurst = speaker === 'user' && last?.speaker === speaker && last.turnSeq === turnSeq;

    setTranscript((prev) => {
      const tail = prev[prev.length - 1];
      const agentContinues = speaker === 'agent' && tail?.speaker === 'agent';
      if (tail && (agentContinues || (sameUserBurst && tail.speaker === 'user'))) {
        const merged = mergeTranscriptText(tail.text, text);
        if (merged === tail.text) return prev;
        return prev.map((l, i) => (i === prev.length - 1 ? { ...l, text: merged } : l));
      }
      return [...prev, { id: `${speaker}-${prev.length}`, speaker, text }];
    });
    lastFinalTurnRef.current = { speaker, turnSeq };
  }, []);

  const handleCustomEvent = useCallback(
    (name: string, value: Record<string, unknown>) => {
      switch (name) {
        case 'voice_session_ready':
          startAudio(value.inputSampleRate as number, value.outputSampleRate as number)
            .then(() => mountedRef.current && setState('listening'))
            .catch((err) => {
              fail(err);
              stop();
            });
          break;
        case 'voice_activity':
          if (value.speaker === 'user') setState(value.state === 'start' ? 'listening' : 'thinking');
          else if (value.speaker === 'agent') setState(value.state === 'start' ? 'speaking' : 'listening');
          break;
        case 'voice_transcript':
          handleTranscript(value as unknown as VoiceTranscriptValue);
          break;
        case 'voice_interrupted':
          acceptedTurnSeqRef.current = value.turnSeq as number;
          resetPlayer();
          break;
        case 'voice_session_ended':
          setEndReason((value.reason as PersonaVoiceEndReason) ?? null);
          setState('ended');
          closeSocket();
          teardownAudio();
          break;
        default:
          break;
      }
    },
    [closeSocket, fail, handleTranscript, resetPlayer, startAudio, stop, teardownAudio],
  );

  const handleMessage = useCallback(
    (event: WebSocketMessageEvent) => {
      const data = event.data as ArrayBuffer | string;
      if (typeof data !== 'string') {
        if (data.byteLength < 4) return;
        const turnSeq = new DataView(data).getUint32(0, true);
        // Frames from a turn the user already talked over are dropped.
        if (turnSeq >= acceptedTurnSeqRef.current) {
          acceptedTurnSeqRef.current = turnSeq;
          statsRef.current.rxFrames += 1;
          statsRef.current.rxBytes += data.byteLength - 4;
          playPcm(data.slice(4));
        } else {
          statsRef.current.dropped += 1;
        }
        return;
      }

      let msg: Record<string, unknown>;
      try {
        msg = JSON.parse(data);
      } catch {
        return;
      }
      if (msg.type === 'CUSTOM') logger.debug(`event ${msg.name as string}`, msg.value as Record<string, unknown>);
      else logger.debug(`event ${msg.type as string}`, msg);
      switch (msg.type) {
        case 'CUSTOM':
          handleCustomEvent(msg.name as string, (msg.value ?? {}) as Record<string, unknown>);
          break;
        case 'TOOL_CALL_CHUNK':
          upsertToolCall(msg.toolCallId as string, { name: msg.toolCallName as string | undefined, status: 'running' });
          break;
        case 'TOOL_CALL_RESULT': {
          let parsed: { output?: unknown; error?: string } | null;
          try {
            parsed = JSON.parse(msg.content as string);
          } catch {
            parsed = { output: msg.content };
          }
          upsertToolCall(msg.toolCallId as string, {
            status: parsed?.error ? 'error' : 'done',
            summary:
              parsed?.error ||
              (typeof parsed?.output === 'string' ? parsed.output : JSON.stringify(parsed?.output ?? '')),
          });
          break;
        }
        case 'RUN_ERROR':
          fail(new Error((msg.message as string) || 'The agent run failed.'));
          break;
        default:
          break;
      }
    },
    [fail, handleCustomEvent, logger, playPcm, upsertToolCall],
  );

  const start = useCallback(async () => {
    if (!agentId) {
      fail(new Error('No assistant agent configured (EXPO_PUBLIC_PERSONA_AGENT_ID).'));
      return;
    }
    closeSocket();
    teardownAudio();
    setError(null);
    setEndReason(null);
    setTranscript([]);
    setPartial(null);
    setToolCalls([]);
    acceptedTurnSeqRef.current = 0;
    lastFinalTurnRef.current = null;
    statsRef.current = { micFrames: 0, micBytes: 0, rxFrames: 0, rxBytes: 0, dropped: 0, last: 0 };
    setState('connecting');
    logger.debug('start() called', { agentId, threadId, hasContext: !!context, hasContextOverride: !!contextOverride });

    try {
      const permission = await AudioManager.requestRecordingPermissions();
      logger.debug('mic permission', { permission });
      if (permission !== 'Granted') {
        throw new Error('Microphone permission is needed for voice mode.');
      }

      const res = await fetchWithAuth('/voice/sessions', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          agentId,
          ...(threadId ? { threadId } : {}),
          ...(contextOverride ? { contextOverride } : {}),
          ...(context ? { context } : {}),
        }),
      });
      if (!res.ok) {
        const detail = await res.text().catch(() => '');
        logger.error('ticket mint failed', { status: res.status, detail: detail.slice(0, 500) });
        throw new Error(`Could not start voice (${res.status}).`);
      }
      const body = await res.json();
      const ticket = (body?.data ?? body) as VoiceSessionTicket;
      if (!ticket?.wsUrl) throw new Error('Server did not return a voice session URL.');
      logger.debug('ticket minted, opening socket', { wsHost: ticket.wsUrl.split('?')[0] });

      const ws = new WebSocket(ticket.wsUrl);
      ws.binaryType = 'arraybuffer';
      wsRef.current = ws;
      ws.onopen = () => logger.debug('socket open');
      ws.onmessage = handleMessage;
      ws.onerror = (e) => {
        logger.warn('socket error', { message: (e as { message?: string }).message });
        if (wsRef.current === ws) fail(new Error('Voice connection error.'));
      };
      ws.onclose = (e) => {
        logger.debug('socket closed', { code: e.code, reason: e.reason, stale: wsRef.current !== ws });
        if (wsRef.current !== ws) return;
        wsRef.current = null;
        teardownAudio();
        if (mountedRef.current) setState((prev) => (prev === 'error' || prev === 'ended' ? prev : 'idle'));
      };
    } catch (err) {
      fail(err);
      teardownAudio();
    }
  }, [agentId, threadId, contextOverride, context, closeSocket, fail, fetchWithAuth, handleMessage, logger, teardownAudio]);

  const mute = useCallback((muted: boolean) => {
    mutedRef.current = muted;
    setIsMuted(muted);
  }, []);

  const sendText = useCallback((text: string) => {
    if (!text?.trim() || wsRef.current?.readyState !== WebSocket.OPEN) return;
    wsRef.current.send(JSON.stringify({ type: 'voice.text', text }));
  }, []);

  const updateContext = useCallback((next: Record<string, unknown>) => {
    if (wsRef.current?.readyState !== WebSocket.OPEN) return;
    wsRef.current.send(JSON.stringify({ type: 'voice.context', context: next }));
  }, []);

  return { state, isMuted, transcript, partial, toolCalls, error, endReason, start, stop, mute, sendText, updateContext };
}

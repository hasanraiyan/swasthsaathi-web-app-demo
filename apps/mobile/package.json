{
  "name": "@swasthsaathi/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "cross-env NODE_OPTIONS=\"--no-strip-types\" expo start",
    "dev": "cross-env NODE_OPTIONS=\"--no-strip-types\" expo start",
    "android": "cross-env NODE_OPTIONS=\"--no-strip-types\" expo run:android",
    "ios": "cross-env NODE_OPTIONS=\"--no-strip-types\" expo run:ios",
    "web": "cross-env NODE_OPTIONS=\"--no-strip-types\" expo start --web",
    "prebuild": "cross-env NODE_OPTIONS=\"--no-strip-types\" expo prebuild",
    "prebuild:clean": "cross-env NODE_OPTIONS=\"--no-strip-types\" expo prebuild --clean",
    "check-types": "tsc --noEmit",
    "clean": "rimraf .expo dist android ios"
  },
  "dependencies": {
    "@clerk/expo": "^4.6.8",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/metro-runtime": "~57.0.16",
    "@expo/vector-icons": "^15.1.1",
    "@personaai/react": "0.17.1",
    "@swasthsaathi/types": "workspace:*",
    "expo": "~57.0.24",
    "expo-auth-session": "~57.0.12",
    "expo-build-properties": "^57.0.21",
    "expo-constants": "~57.0.19",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-font": "~57.0.4",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.10",
    "expo-network": "~57.0.2",
    "expo-router": "~57.0.22",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "^57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-audio-api": "^0.13.6",
    "react-native-markdown-display": "^7.0.2",
    "react-native-qrcode-svg": "^6.3.26",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~19.2.18",
    "babel-preset-expo": "~57.0.12",
    "rimraf": "^6.0.1",
    "typescript": "^6.0.3"
  }
}

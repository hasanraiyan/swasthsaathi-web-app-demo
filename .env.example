# ==========================================
# SwasthSaathi Monorepo Environment Variables
# ==========================================

# Clerk Authentication (Get these from https://dashboard.clerk.com)
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key_here
CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key_here

# Mobile / Web Expo Clerk Key (Must match CLERK_PUBLISHABLE_KEY)
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key_here

# MongoDB Connection
MONGODB_URI=mongodb://127.0.0.1:27017/swasthsaathi

# NestJS API Port & Mobile API URL
PORT=4000
EXPO_PUBLIC_API_URL=http://localhost:4000

# Persona.ai assistant
# Server-only (apps/api/.env) — NEVER prefix with EXPO_PUBLIC_
PERSONA_BASE_URL=https://api.persona.hasanraiyan.me
PERSONA_CREDENTIAL=<keyId>.<secret>
# Mobile (apps/mobile/.env)
EXPO_PUBLIC_PERSONA_AGENT_ID=your_agent_id
